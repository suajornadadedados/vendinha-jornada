# Vendinha — variáveis de ambiente.
#
#   cp .env.example .env
#
# Este arquivo é a REFERÊNCIA e vive no Git. O `.env` de verdade não: está no
# .gitignore e a leitura dele está negada ao agente em .claude/settings.json.
# São garantias diferentes — o .gitignore impede o commit, a regra de permissão
# impede a leitura. Segredo lido entra no contexto, e contexto sai da máquina.
#
# Exaustivo de propósito: toda variável que o produto vai precisar até a S-08
# está aqui, comentada e marcada com a spec que a torna necessária. Variável que
# aparece de surpresa no meio de uma spec é variável que ninguém documentou.
#
# NUNCA preencher com dado real: CPF, CNPJ, certificado ou chave de produção.

# ─────────────────────────────────────────────────────────────────────────────
# Aplicação                                                            (S-02)
# ─────────────────────────────────────────────────────────────────────────────
APP_ENV=local                  # local | dev | prod
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000

# URL pública do backend. Em local é o túnel/host que o webhook do gateway
# consegue alcançar — o Mercado Pago precisa chegar até você (S-04).
PUBLIC_BASE_URL=http://localhost:8000

# ─────────────────────────────────────────────────────────────────────────────
# Postgres — domínio + checkpointer do LangGraph                       (S-02)
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=vendinha
POSTGRES_PASSWORD=vendinha
POSTGRES_DB=vendinha

# Porta NO HOST. O contêiner sempre escuta 5432 internamente; isto é só o que
# fica exposto em 127.0.0.1. Troque se a 5432 já estiver ocupada na sua máquina
# (um Postgres nativo, ou outro projeto) — o compose respeita esta variável.
POSTGRES_PORT=5432

DATABASE_URL=postgresql://vendinha:vendinha@localhost:5432/vendinha

# ─────────────────────────────────────────────────────────────────────────────
# Qdrant — catálogo vetorizado                                         (S-03)
# ─────────────────────────────────────────────────────────────────────────────
QDRANT_HTTP_PORT=6333          # porta no host; mesma observação da POSTGRES_PORT
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=catalogo

# ─────────────────────────────────────────────────────────────────────────────
# Modelo                                                        (S-02, S-06)
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ID completo do modelo, sem sufixo de data. O roteamento por tarefa (modelo
# mais barato onde couber) é decisão da S-02 sob o R6, não deste arquivo.
ANTHROPIC_MODEL=claude-opus-5

# ─────────────────────────────────────────────────────────────────────────────
# Langfuse Cloud — observabilidade                        (S-02, ADR-007/010)
# ─────────────────────────────────────────────────────────────────────────────
# NÃO é contêiner: desde o ADR-010 o Langfuse é Cloud, e por isso o trace SAI da
# nossa infra. O mascaramento de PII (R5) deixou de ser higiene e virou
# pré-condição de release. Indisponibilidade do Langfuse nunca pode propagar
# exceção para o atendimento.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Limites de custo e latência — R6                                     (S-02)
# ─────────────────────────────────────────────────────────────────────────────
SESSION_BUDGET_USD=0.50        # teto por sessão de atendimento
TOOL_TIMEOUT_SECONDS=20        # teto por chamada de tool

# ─────────────────────────────────────────────────────────────────────────────
# Mercado Pago (sandbox) — pagamento                                   (S-04)
# ─────────────────────────────────────────────────────────────────────────────
# Sandbox, sempre. Credencial de produção não entra neste projeto.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=    # verificação de origem do webhook (R8)

# ─────────────────────────────────────────────────────────────────────────────
# Emissor de NF-e                                              (S-05, S-09)
# ─────────────────────────────────────────────────────────────────────────────
# mock: DANFE/XML fiéis ao layout, com tarja "SEM VALOR FISCAL" (S-05).
# homologacao: adapter real contra ambiente de homologação (S-09, opcional).
# A troca é de configuração, não de código — é o que o port existe para provar.
NF_EMITTER=mock
NF_EMITTER_API_KEY=
NF_EMITTER_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Frontend                                                             (S-07)
# ─────────────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

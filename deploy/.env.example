# Ambiente de deploy — copie para `deploy/.env` e preencha.
#
#     cp deploy/.env.example deploy/.env
#
# `deploy/.env` já é ignorado pelo git (`.gitignore` cobre `.env` em qualquer
# profundidade) e a leitura dele está negada ao agente em `.claude/settings.json`.
# São duas proteções diferentes de propósito: uma impede o commit, a outra impede
# que o segredo entre no contexto de um modelo. Segredo lido sai da máquina.
#
# Este arquivo lista SÓ o que muda em relação ao `.env.example` da raiz. O resto
# tem default no código (`backend/vendinha/config.py`) e não precisa aparecer
# aqui — variável repetida sem motivo é variável que vai divergir.
#
# `DATABASE_URL` e `QDRANT_URL` NÃO estão aqui: o compose as monta a partir das
# credenciais abaixo, porque os nomes de host são dele. Quem edita este arquivo
# não deveria precisar saber que o serviço se chama `postgres`.

# ─────────────────────────────────────────────────────────────────────────────
# A porta publicada no host
# ─────────────────────────────────────────────────────────────────────────────
# A única do ambiente: Postgres e Qdrant não publicam porta nenhuma.
HTTP_PORT=8080

# ─────────────────────────────────────────────────────────────────────────────
# Aplicação
# ─────────────────────────────────────────────────────────────────────────────
# **Qualquer valor diferente de `local` tranca a escrita de configuração.** Em
# `APP_ENV=local` a rota `PUT /config` aceita gravar a credencial do provedor;
# fora dele responde 403 e a tela de Configurações fica somente leitura (S-02
# D-8, e é a intenção — não há autenticação neste projeto).
#
# A consequência prática está no RUNBOOK e vale repetir: a chave do modelo TEM
# que vir daqui. Não dá para corrigi-la pela interface depois de subir.
APP_ENV=deploy
LOG_LEVEL=INFO

# A URL por onde o mundo de fora alcança a API — e ela **termina em `/api`**.
#
# Não é enfeite: é dela que saem o link de pagamento que o cliente recebe, o
# `notification_url` do gateway e os links de DANFE e XML do painel. O nginx
# serve a landing em `/` e a API em `/api/`, então sem o prefixo o link cai no
# fallback da landing — o cliente abre e vê a página inicial.
PUBLIC_BASE_URL=http://localhost:8080/api

# De onde o navegador pode chamar a API. **Vazio de propósito**: o nginx serve as
# telas e a API na MESMA origem, então não existe requisição entre origens para
# autorizar. Preencher aqui não conserta nada e só dá a impressão de que existe
# uma segunda origem em algum lugar.
CORS_ORIGINS=

# ─────────────────────────────────────────────────────────────────────────────
# Postgres — o compose monta a DATABASE_URL a partir destas três
# ─────────────────────────────────────────────────────────────────────────────
# Sem default no compose, de propósito: aqui uma senha default seria uma senha
# de produção que ninguém escolheu. O compose recusa subir se faltarem.
POSTGRES_USER=vendinha
POSTGRES_PASSWORD=
POSTGRES_DB=vendinha

# ─────────────────────────────────────────────────────────────────────────────
# Credenciais do modelo
# ─────────────────────────────────────────────────────────────────────────────
# Para a conversa.
ANTHROPIC_API_KEY=

# **Também necessária, mesmo numa instância que conversa só por Anthropic.** O
# seed embeda pela OpenAI (S-03 D-1), e o `bootstrap` do compose roda o seed
# antes de a API subir: sem esta chave o ambiente inteiro para na primeira
# subida, com o erro vindo da ingestão e não da API.
OPENAI_API_KEY=

# Cifra a credencial gravada no banco (ADR-012). Ausente significa que a escrita
# é RECUSADA — nunca que o segredo é guardado em claro. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONFIG_ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# O token do operador
# ─────────────────────────────────────────────────────────────────────────────
# Sem ele, a fila e as rotas de aprovar/rejeitar respondem 401 e o painel fecha
# inteiro — o lado seguro, porque essa fila lista dados de compradoras e autoriza
# uma emissão irreversível.
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Ele é digitado numa tela e guardado no `sessionStorage` da aba. **Sem TLS ele
# trafega em claro**, e é uma das razões pelas quais este ambiente não vai para a
# internet aberta (ADR-008).
OPERADOR_API_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Observabilidade — Langfuse Cloud (ADR-010)
# ─────────────────────────────────────────────────────────────────────────────
# Opcional: sem as duas chaves a instrumentação não instancia o cliente e o
# atendimento segue normalmente — indisponibilidade do Langfuse nunca derruba o
# atendimento.
#
# A REGIÃO do projeto (EU/US) é decisão de LGPD e está registrada no RUNBOOK.
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Pagamento e nota fiscal
# ─────────────────────────────────────────────────────────────────────────────
# Ausente = adapter mock, e não existe interruptor `PAYMENT_GATEWAY`: ele
# permitiria `mercadopago` sem token, que sobe bem e quebra no primeiro pedido.
MERCADOPAGO_ACCESS_TOKEN=
# VAZIO significa que NENHUMA assinatura confere e o webhook recusa tudo com 401
# — o lado seguro.
MERCADOPAGO_WEBHOOK_SECRET=

# `mock` é o único adapter que existe, e não haverá outro (ADR-004).
NF_EMITTER=mock
